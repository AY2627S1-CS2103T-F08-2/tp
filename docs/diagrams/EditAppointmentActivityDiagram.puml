@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:User enters editappt ID ~--appt OLD
[~--to NEW] [~--details DETAILS];

'Since the beta syntax does not support placing the condition outside the
'diamond we place it as the true branch instead.

if () then ([input is valid, with --to
or --details or both])
    if () then ([a patient has ID])
        if () then ([the patient has an
appointment at OLD])
            :Build the edited appointment from NEW and
            DETAILS, keeping the old values not given;
            if () then ([moved onto another of
the patient's appointments])
                :Show the error;
                stop
            else ([else])
                :Replace the old appointment
                with the edited one;
                :Save the data file;
                :Show the Appointments view and
                select the edited appointment;
                stop
            endif
        else ([else])
            :Show the error, listing the
            patient's appointments that day;
            stop
        endif
    else ([else])
        :Show the error;
        stop
    endif
else ([else])
    :Show the error;
    stop
endif
@enduml
