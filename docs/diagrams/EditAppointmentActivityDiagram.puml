@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:User enters editappt ID (NUMBER or ~--appt OLD)
[~--to NEW] [~--details DETAILS];

'Since the beta syntax does not support placing the condition outside the
'diamond we place it as the true branch instead.

if () then ([input is valid, with --to
or --details or both])
    if () then ([a patient has ID])
        if () then ([selector resolves to
exactly one appointment])
            :Build the edited appointment from NEW and
            DETAILS, keeping its number, completion status
            and values not given;
            :Replace the old appointment
            with the edited one;
            if () then ([two undone visits clash])
                :Append a warning naming the
                other patients and appointment numbers;
            endif
            :Save the data file;
            :Show the Appointments view and
            select the edited appointment by identity;
            stop
        else ([else])
            :Show missing-number or timestamp error,
            listing numbered matches or same-day visits;
            stop
        endif
    else ([else])
        :Show the error;
        stop
    endif
else ([else])
    :Show the error;
    stop
endif
@enduml
