@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":LaiNurseParser" as LaiNurseParser LOGIC_COLOR
participant ":DeleteAppointmentCommandParser" as DeleteAppointmentCommandParser LOGIC_COLOR
participant "a:Appointment" as Appointment LOGIC_COLOR
participant "l:AppointmentLookup" as AppointmentLookup LOGIC_COLOR
participant "d:DeleteAppointmentCommand" as DeleteAppointmentCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("deleteappt S1234567A --appt 2026-10-05 09:30")
activate LogicManager

LogicManager -> LaiNurseParser : parseCommand("deleteappt S1234567A --appt 2026-10-05 09:30")
activate LaiNurseParser

create DeleteAppointmentCommandParser
LaiNurseParser -> DeleteAppointmentCommandParser
activate DeleteAppointmentCommandParser

DeleteAppointmentCommandParser --> LaiNurseParser
deactivate DeleteAppointmentCommandParser

LaiNurseParser -> DeleteAppointmentCommandParser : parse("S1234567A --appt 2026-10-05 09:30")
activate DeleteAppointmentCommandParser

create Appointment
DeleteAppointmentCommandParser -> Appointment : Appointment("2026-10-05 09:30")
activate Appointment

Appointment --> DeleteAppointmentCommandParser
deactivate Appointment

create DeleteAppointmentCommand
DeleteAppointmentCommandParser -> DeleteAppointmentCommand : DeleteAppointmentCommand(S1234567A, a)
activate DeleteAppointmentCommand

DeleteAppointmentCommand --> DeleteAppointmentCommandParser
deactivate DeleteAppointmentCommand

DeleteAppointmentCommandParser --> LaiNurseParser : d
deactivate DeleteAppointmentCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteAppointmentCommandParser -[hidden]-> LaiNurseParser
destroy DeleteAppointmentCommandParser

LaiNurseParser --> LogicManager : d
deactivate LaiNurseParser

LogicManager -> DeleteAppointmentCommand : execute(m)
activate DeleteAppointmentCommand

DeleteAppointmentCommand -> Model : findPatientById(S1234567A)
activate Model

Model --> DeleteAppointmentCommand : p
deactivate Model

DeleteAppointmentCommand -> AppointmentLookup : find(S1234567A, p.getSchedule(), target, COMMAND_WORD)
activate AppointmentLookup

AppointmentLookup --> DeleteAppointmentCommand : foundAppointment
deactivate AppointmentLookup

DeleteAppointmentCommand -> DeleteAppointmentCommand : schedule.remove(foundAppointment)
activate DeleteAppointmentCommand

DeleteAppointmentCommand --> DeleteAppointmentCommand : editedSchedule
deactivate DeleteAppointmentCommand

DeleteAppointmentCommand -> Model : setPatient(p, editedPatient)
activate Model

Model --> DeleteAppointmentCommand
deactivate Model

create CommandResult
DeleteAppointmentCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteAppointmentCommand
deactivate CommandResult

DeleteAppointmentCommand --> LogicManager : r
deactivate DeleteAppointmentCommand

[<--LogicManager
deactivate LogicManager
@enduml
