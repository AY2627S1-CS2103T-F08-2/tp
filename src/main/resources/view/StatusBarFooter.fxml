<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<!-- The completion hint fills the room that the save location leaves. It is hidden, not removed, when there is
     nothing to complete, so that the save location stays at the right end while the user types. -->
<HBox styleClass="status-bar" alignment="CENTER_LEFT" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <HBox fx:id="completionHint" styleClass="completion-hint" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
        minWidth="0" visible="false">
    <Label styleClass="tab-key" text="Tab">
      <minWidth>
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
    <Label fx:id="completionList" minWidth="0" />
  </HBox>
  <Label fx:id="saveLocationStatus">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
</HBox>
