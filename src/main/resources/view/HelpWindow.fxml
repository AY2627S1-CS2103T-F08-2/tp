<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <icons>
        <Image url="@/images/help_icon.png" />
    </icons>
    <scene>
        <Scene>
            <stylesheets>
                <URL value="@HelpWindow.css" />
            </stylesheets>

            <VBox fx:id="helpWindowRoot" prefHeight="650.0" prefWidth="850.0" spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                </padding>
                <children>
                    <HBox alignment="CENTER" spacing="10.0">
                        <children>
                            <Label fx:id="helpMessage" text="Label" />
                            <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
                        </children>
                    </HBox>

                    <!-- Native ScrollPane for rendering styled nodes -->
                    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="contentContainer" />
                        </content>
                    </ScrollPane>
                </children>
            </VBox>
        </Scene>
    </scene>
</fx:root>
