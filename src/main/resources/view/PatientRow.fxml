<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox id="rowPane" fx:id="rowPane" alignment="CENTER_LEFT" spacing="8" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="12" bottom="8" left="12" />
  </padding>
  <Label fx:id="index" styleClass="patient-row-index">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
  <Label fx:id="name" styleClass="patient-row-name" text="\$name" />
  <Label fx:id="patientId" styleClass="patient-row-id" text="\$patientId">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
  <Region HBox.hgrow="ALWAYS" />
  <Label fx:id="nextAppointment" styleClass="patient-row-appointment" text="\$nextAppointment">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
</HBox>
