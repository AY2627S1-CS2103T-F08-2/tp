<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="list-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <!-- The same header as the appointment list's: what the list shows, and a count. -->
  <HBox fx:id="header" styleClass="list-header" alignment="CENTER_LEFT" spacing="6">
    <padding>
      <Insets top="6" right="12" bottom="6" left="8" />
    </padding>
    <Label fx:id="listTitle" styleClass="list-header-title">
      <padding>
        <Insets left="4" />
      </padding>
      <minWidth>
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
    <Region HBox.hgrow="ALWAYS" />
    <!-- The count ends where the rows' next appointments end, which PatientListPanel keeps up to date. -->
    <Label fx:id="listCount" styleClass="list-header-count" />
  </HBox>
  <ListView fx:id="patientListView" VBox.vgrow="ALWAYS" />
</VBox>
